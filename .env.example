DATABASE_URL=postgresql://divetracx:divetracx@localhost:5433/divetracx

# Recursively imports DiveMate.ddb and referenced images from private Drive.
# Share the folder with the service account configured in this credential file.
# DIVEMATE_GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/divetracx-service-account.json

# Maximum accepted backup size in bytes (defaults to 50 MiB).
# DIVEMATE_MAX_BACKUP_BYTES=52428800
# DIVEMATE_MAX_IMAGE_BYTES=104857600

# Picture storage (local by default; use the S3 variables for compatible stores).
# STORAGE_PROVIDER=local
# STORAGE_PATH=./uploads
# STORAGE_URL=/media
# S3_BUCKET=divetracx
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
