DATABASE_URL=postgresql://divetracx:divetracx@localhost:5433/divetracx

# Docker Compose authentication gate
HODOR_PASSWORD=change-me
HODOR_SECRET=replace-with-a-long-random-secret
HODOR_PORT=3000
HODOR_TITLE=Divetracx Login
HODOR_SESSION_TTL=86400
HODOR_SECURE_COOKIE=false
HODOR_LOG_FORMAT=compact

# Recursively imports DiveMate.ddb and referenced images from private Drive.
# Share the folder with the service account configured in this credential file.
# DIVEMATE_GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/divetracx-service-account.json

# Maximum accepted backup size in bytes (defaults to 50 MiB).
# DIVEMATE_MAX_BACKUP_BYTES=52428800
# DIVEMATE_MAX_IMAGE_BYTES=104857600

# Garmin Activity API access requires Garmin Developer Program approval. These URLs
# point to a server-side adapter implementing the documented Divetracx adapter
# envelope; partner OAuth/feed/cursor details stay in that adapter.
# GARMIN_ADAPTER_FULL_IMPORT_URL=https://garmin-adapter.example.test/full
# GARMIN_ADAPTER_INCREMENTAL_IMPORT_URL=https://garmin-adapter.example.test/incremental
# GARMIN_ADAPTER_AUTHORIZATION=Bearer replace-with-adapter-secret
# GARMIN_ADAPTER_TIMEOUT_MS=30000
# GARMIN_ADAPTER_MAX_RESPONSE_BYTES=104857600
# GARMIN_MAX_FIT_BYTES=26214400

# Picture storage (local by default; use the S3 variables for compatible stores).
# STORAGE_PROVIDER=local
# STORAGE_PATH=./uploads
# STORAGE_URL=/media
# S3_BUCKET=divetracx
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
