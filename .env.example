DATABASE_URL=postgresql://divetracx:divetracx@localhost:5433/divetracx

# Docker Compose authentication gate
HODOR_PASSWORD=change-me
HODOR_SECRET=replace-with-a-long-random-secret
HODOR_PORT=3000
HODOR_TITLE=Divetracx Login
HODOR_SESSION_TTL=86400
HODOR_SECURE_COOKIE=false
HODOR_LOG_FORMAT=compact

# Recursively imports DiveMate.ddb and referenced images from private Drive.
# Share the folder with the service account configured in this credential file.
# DIVEMATE_GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/divetracx-service-account.json

# Maximum accepted backup size in bytes (defaults to 50 MiB).
# DIVEMATE_MAX_BACKUP_BYTES=52428800
# DIVEMATE_MAX_IMAGE_BYTES=104857600

# Garmin imports go through the bundled adapter (scripts/garmin-adapter.ts), a
# server-side service that logs in to Garmin Connect with persisted tokens and
# returns dive activities plus FIT files. With Docker Compose, start it with
# `docker compose --profile garmin up -d`, then connect the Garmin account once
# in Divetracx under Settings -> Integrations; tokens persist on the adapter
# volume.
# GARMIN_ADAPTER_FULL_IMPORT_URL=http://garmin-adapter:8787/import
# GARMIN_ADAPTER_INCREMENTAL_IMPORT_URL=http://garmin-adapter:8787/import
# GARMIN_ADAPTER_AUTHORIZATION=Bearer replace-with-adapter-secret
# GARMIN_ADAPTER_TIMEOUT_MS=30000
# GARMIN_ADAPTER_MAX_RESPONSE_BYTES=104857600
# GARMIN_MAX_FIT_BYTES=26214400

# Adapter-side settings (read by scripts/garmin-adapter.ts).
# GARMIN_TOKEN_DIRECTORY=/data/garmin-tokens
# GARMIN_DOMAIN=garmin.com
# GARMIN_ACTIVITY_PAGE_SIZE=50
# GARMIN_FULL_IMPORT_MAX_ACTIVITIES=2000
# GARMIN_INCREMENTAL_OVERLAP_SECONDS=3600
# GARMIN_MFA_CHALLENGE_TTL_SECONDS=300

# Picture storage (local by default; use the S3 variables for compatible stores).
# STORAGE_PROVIDER=local
# STORAGE_PATH=./uploads
# STORAGE_URL=/media
# S3_BUCKET=divetracx
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
