     HttpClient.prototype.handleMFA = function (htmlStr) {
         if (!htmlStr) return;
-        if (htmlStr.indexOf('MFA') !== -1 || htmlStr.indexOf('mfa') !== -1 || htmlStr.indexOf('Mfa') !== -1) {
