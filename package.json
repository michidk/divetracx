{
  "name": "divetracx",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration:divemate-export": "RUN_DIVEMATE_INTEGRATION_TESTS=true bun test src/modules/divemate/server/writeback.integration.test.ts",
    "test:integration:imports": "RUN_IMPORT_INTEGRATION_TESTS=true bun test src/modules/integrations/server/import-service.integration.test.ts",
    "check:helm": "bash scripts/verify-helm.sh",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build && bun run check:helm",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sync:divemate": "bun run scripts/sync-divemate.ts",
    "garmin:adapter": "bun run scripts/garmin-adapter.ts",
    "media:refresh-thumbnails": "bun run scripts/refresh-thumbnails.ts",
    "import:incremental": "bun run scripts/import-integration.ts",
    "export:divemate": "bun run scripts/export-divemate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@base-ui/react": "^1.7.0",
    "@garmin/fitsdk": "21.214.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "axios-cookiejar-support": "7.0.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "garmin-connect-2fa": "1.6.3",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "tough-cookie": "6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tanstack/router-cli": "^1.167.17",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260610-beta",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
