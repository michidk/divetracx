{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Divetracx Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "serviceAccount",
    "service",
    "ingress",
    "resources",
    "migrations",
    "sync",
    "divemate",
    "storage",
    "postgresql",
    "hodor",
    "networkPolicy"
  ],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": { "type": "object" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "startupProbe": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "migrations": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "hook", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "hook": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "sync": {
      "type": "object",
      "required": [
        "enabled",
        "schedule",
        "timeZone",
        "concurrencyPolicy",
        "startingDeadlineSeconds",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit",
        "backoffLimit",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string" },
        "concurrencyPolicy": {
          "type": "string",
          "enum": ["Allow", "Forbid", "Replace"]
        },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "divemate": {
      "type": "object",
      "required": [
        "existingSecret",
        "googleDriveFolderId",
        "googleCredentialsSecretKey",
        "maxBackupBytes",
        "maxImageBytes"
      ],
      "properties": {
        "existingSecret": { "type": "string" },
        "googleDriveFolderId": { "type": "string" },
        "googleCredentialsSecretKey": { "type": "string", "minLength": 1 },
        "maxBackupBytes": { "type": "integer", "minimum": 1 },
        "maxImageBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "storage": { "type": "object" },
    "postgresql": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "service",
        "auth",
        "primary",
        "external",
        "existingSecret",
        "existingSecretKey"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "service": { "type": "object" },
        "auth": { "type": "object" },
        "primary": { "type": "object" },
        "external": { "type": "object" },
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 }
      }
    },
    "hodor": { "type": "object" },
    "networkPolicy": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
